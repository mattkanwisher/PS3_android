Subject: cmake: allow overriding the non-Apple arm64 -march baseline
Why: The hardwired armv8.1-a baseline (LSE) SIGILLs on environments
     without v8.1 support, e.g. the Android emulator's arm64-to-x86_64
     binary translator used for automated testing. RPCS3_ARM_BASELINE
     lets embedders build a compatibility variant while armv8.1-a stays
     the default.
Upstream-status: candidate

diff --git a/buildfiles/cmake/ConfigureCompiler.cmake b/buildfiles/cmake/ConfigureCompiler.cmake
index ea8cd32..d7b2397 100644
--- a/buildfiles/cmake/ConfigureCompiler.cmake
+++ b/buildfiles/cmake/ConfigureCompiler.cmake
@@ -37,7 +37,10 @@ else()
 		if (APPLE)
 			add_compile_options(-march=armv8.4-a)
 		else()
-			add_compile_options(-march=armv8.1-a)
+			if(NOT RPCS3_ARM_BASELINE)
+				set(RPCS3_ARM_BASELINE armv8.1-a)
+			endif()
+			add_compile_options(-march=${RPCS3_ARM_BASELINE})
 		endif()
 	elseif(COMPILER_X86)
 		# Some compilers will set both X86 and ARM, so check explicitly for ARM first
