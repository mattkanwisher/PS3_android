Subject: audio: fall back to the default output when cubeb cannot enumerate
Why: CubebBackend::GetDevice() treats a failed cubeb_enumerate_devices() as
     fatal, but cubeb's Android backends (AAudio, OpenSL) do not implement
     enumeration and return CUBEB_ERROR_NOT_SUPPORTED, so audio never
     initialises on Android at all. Those backends can still open the system
     default output, which cubeb_stream_init() selects for a null device id.
     Treat that case as the default device instead of failing.
Upstream-status: candidate

--- a/rpcs3/Emu/Audio/Cubeb/CubebBackend.cpp
+++ b/rpcs3/Emu/Audio/Cubeb/CubebBackend.cpp
@@ -91,7 +91,9 @@
 
 	device_handle device = GetDevice();
 
-	return !device.handle || device.id != m_default_device;
+	// Backends without enumeration always report the same synthetic default,
+	// so a null handle there is not a device change.
+	return (!device.handle && device.id != audio_device_enumerator::DEFAULT_DEV_ID) || device.id != m_default_device;
 }
 
 bool CubebBackend::Open(std::string_view dev_id, AudioFreq freq, AudioSampleSize sample_size, AudioChannelCnt ch_cnt, audio_channel_layout layout)
@@ -112,7 +114,9 @@
 
 	device_handle device = GetDevice(use_default_device ? "" : dev_id);
 
-	if (!device.handle)
+	// A null handle is meaningful when it stands for the backend default
+	// (see GetDevice); only a named device that went missing is an error.
+	if (!device.handle && device.id != audio_device_enumerator::DEFAULT_DEV_ID)
 	{
 		if (use_default_device) Cubeb.error("Opening default device failed");
 		else Cubeb.error("Device with id=%s not found", dev_id);
@@ -273,6 +277,17 @@
 	cubeb_device_collection dev_collection{};
 	if (int err = cubeb_enumerate_devices(m_ctx, CUBEB_DEVICE_TYPE_OUTPUT, &dev_collection))
 	{
+		// Not every backend can enumerate: cubeb's Android backends (AAudio and
+		// OpenSL) return CUBEB_ERROR_NOT_SUPPORTED. They can still open the
+		// system default output, which cubeb_stream_init selects for a null
+		// device id, so treat that as the default device rather than failing
+		// audio outright.
+		if (default_dev && err == CUBEB_ERROR_NOT_SUPPORTED)
+		{
+			Cubeb.notice("Device enumeration is unsupported by this backend; using the system default output");
+			return device_handle{ .handle = nullptr, .id = std::string(audio_device_enumerator::DEFAULT_DEV_ID), .ch_cnt = 2 };
+		}
+
 		Cubeb.error("cubeb_enumerate_devices() failed: %i", err);
 		return {};
 	}
