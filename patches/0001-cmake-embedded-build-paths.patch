Subject: cmake: anchor find-module and include paths to the rpcs3 tree
Why: When rpcs3 is embedded via add_subdirectory() (Android superproject),
     CMAKE_SOURCE_DIR/CMAKE_BINARY_DIR point at the embedding project, so
     FindWolfSSL.cmake, FindZLIB.cmake, and the rpcs3_emu public include root
     resolve to non-existent paths and configure fails. Anchor them to the
     module location / rpcs3 project root instead. No behavior change for
     standalone builds.
Upstream-status: candidate

diff --git a/buildfiles/cmake/FindWolfSSL.cmake b/buildfiles/cmake/FindWolfSSL.cmake
index 35f3168..844a4cb 100644
--- a/buildfiles/cmake/FindWolfSSL.cmake
+++ b/buildfiles/cmake/FindWolfSSL.cmake
@@ -1,3 +1,6 @@
-set(WOLFSSL_LIBRARY wolfssl)
-set(WOLFSSL_INCLUDE_DIR ${CMAKE_SOURCE_DIR}/3rdparty/wolfssl)
-set(WOLFSSL_FOUND TRUE)
+# Anchor on this module's location, not CMAKE_SOURCE_DIR, so the path stays
+# correct when rpcs3 is embedded in a larger project via add_subdirectory().
+get_filename_component(RPCS3_ROOT_DIR "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
+set(WOLFSSL_LIBRARY wolfssl)
+set(WOLFSSL_INCLUDE_DIR ${RPCS3_ROOT_DIR}/3rdparty/wolfssl)
+set(WOLFSSL_FOUND TRUE)
diff --git a/buildfiles/cmake/FindZLIB.cmake b/buildfiles/cmake/FindZLIB.cmake
index ef511d3..564ef22 100644
--- a/buildfiles/cmake/FindZLIB.cmake
+++ b/buildfiles/cmake/FindZLIB.cmake
@@ -4,21 +4,25 @@ if(USE_SYSTEM_ZLIB)
     list(APPEND CMAKE_MODULE_PATH ${CMAKE_CURRENT_LIST_DIR})
 else()
     if(NOT TARGET ZLIB::ZLIB)
+        # Anchor on this module's location, not CMAKE_SOURCE_DIR/CMAKE_BINARY_DIR,
+        # so the paths stay correct when rpcs3 is embedded via add_subdirectory().
+        get_filename_component(RPCS3_ROOT_DIR "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
+        get_property(RPCS3_ROOT_BINARY_DIR DIRECTORY "${RPCS3_ROOT_DIR}" PROPERTY BINARY_DIR)
         add_library(ZLIB::ZLIB STATIC IMPORTED GLOBAL)
         if(MSVC)
             # On MSVC, zlib builds as zs.lib (Release) / zsd.lib (Debug) in per-config subdirectories
             set_target_properties(ZLIB::ZLIB PROPERTIES
-                IMPORTED_LOCATION_RELEASE         "${CMAKE_BINARY_DIR}/3rdparty/zlib/zlib/Release/zs.lib"
-                IMPORTED_LOCATION_DEBUG           "${CMAKE_BINARY_DIR}/3rdparty/zlib/zlib/Debug/zsd.lib"
-                IMPORTED_LOCATION_RELWITHDEBINFO  "${CMAKE_BINARY_DIR}/3rdparty/zlib/zlib/RelWithDebInfo/zs.lib"
-                IMPORTED_LOCATION_MINSIZEREL      "${CMAKE_BINARY_DIR}/3rdparty/zlib/zlib/MinSizeRel/zs.lib")
+                IMPORTED_LOCATION_RELEASE         "${RPCS3_ROOT_BINARY_DIR}/3rdparty/zlib/zlib/Release/zs.lib"
+                IMPORTED_LOCATION_DEBUG           "${RPCS3_ROOT_BINARY_DIR}/3rdparty/zlib/zlib/Debug/zsd.lib"
+                IMPORTED_LOCATION_RELWITHDEBINFO  "${RPCS3_ROOT_BINARY_DIR}/3rdparty/zlib/zlib/RelWithDebInfo/zs.lib"
+                IMPORTED_LOCATION_MINSIZEREL      "${RPCS3_ROOT_BINARY_DIR}/3rdparty/zlib/zlib/MinSizeRel/zs.lib")
         else()
             # On non-MSVC, zlib OUTPUT_NAME is "z" → libz.a
             set_target_properties(ZLIB::ZLIB PROPERTIES
-                IMPORTED_LOCATION "${CMAKE_BINARY_DIR}/3rdparty/zlib/zlib/libz.a")
+                IMPORTED_LOCATION "${RPCS3_ROOT_BINARY_DIR}/3rdparty/zlib/zlib/libz.a")
         endif()
         set_target_properties(ZLIB::ZLIB PROPERTIES
-            INTERFACE_INCLUDE_DIRECTORIES "${CMAKE_SOURCE_DIR}/3rdparty/zlib/zlib;${CMAKE_BINARY_DIR}/3rdparty/zlib/zlib")
+            INTERFACE_INCLUDE_DIRECTORIES "${RPCS3_ROOT_DIR}/3rdparty/zlib/zlib;${RPCS3_ROOT_BINARY_DIR}/3rdparty/zlib/zlib")
     endif()
     set(ZLIB_FOUND TRUE)
 endif()
diff --git a/rpcs3/Emu/CMakeLists.txt b/rpcs3/Emu/CMakeLists.txt
index 8293047..34425da 100644
--- a/rpcs3/Emu/CMakeLists.txt
+++ b/rpcs3/Emu/CMakeLists.txt
@@ -99,7 +99,9 @@ if(APPLE)
     )
 endif()
 
-target_include_directories(rpcs3_emu PUBLIC "${CMAKE_SOURCE_DIR}")
+# PROJECT_SOURCE_DIR (the rpcs3 root), not CMAKE_SOURCE_DIR, so the include
+# root stays correct when rpcs3 is embedded via add_subdirectory().
+target_include_directories(rpcs3_emu PUBLIC "${PROJECT_SOURCE_DIR}")
 
 set_source_files_properties("../../Utilities/JITLLVM.cpp" "../../Utilities/JITASM.cpp" PROPERTIES
     COMPILE_FLAGS "$<IF:$<CXX_COMPILER_ID:MSVC>,/GR-,-fno-rtti>"
