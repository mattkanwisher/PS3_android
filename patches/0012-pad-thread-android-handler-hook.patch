Subject: input: let the embedder provide the pad handler on Android
Why: Android delivers controller input to the focused activity via KeyEvent /
     MotionEvent, not through HID or evdev, so none of the built-in handlers
     can see a handheld's built-in controller. Both ANDROID branches — the
     one in pad_thread::Init() and the one in GetHandler() — bound
     NullPadHandler, silently discarding all input. Call a factory the
     embedder defines instead. No change for any other platform.
Upstream-status: local-only (Android embedders only; upstream has no such handler)

--- a/rpcs3/Input/pad_thread.cpp
+++ b/rpcs3/Input/pad_thread.cpp
@@ -17,6 +17,9 @@
 #endif
 #ifndef ANDROID
 #include "keyboard_pad_handler.h"
+#else
+// Provided by the embedder (see native/bridge/android_pad_handler.cpp).
+std::shared_ptr<PadHandlerBase> make_android_pad_handler();
 #endif
 #include "Emu/Io/Null/NullPadHandler.h"
 #include "Emu/Io/interception.h"
@@ -183,7 +186,9 @@
 				keyptr->SetTargetWindow(static_cast<QWindow*>(m_curwindow));
 				cur_pad_handler = keyptr;
 #else
-				cur_pad_handler = nullpad;
+				// Same embedder-provided handler GetHandler() returns; binding
+				// nullpad here would silently discard all controller input.
+				cur_pad_handler = make_android_pad_handler();
 #endif
 			}
 			else
@@ -858,7 +863,9 @@
 		return std::make_shared<NullPadHandler>();
 	case pad_handler::keyboard:
 #ifdef ANDROID
-		return std::make_shared<NullPadHandler>();
+		// Android delivers controller input to the focused activity, not via
+		// HID/evdev, so the embedder supplies the platform handler.
+		return make_android_pad_handler();
 #else
 		return std::make_shared<keyboard_pad_handler>();
 #endif
