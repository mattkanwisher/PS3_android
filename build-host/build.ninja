#############################################
# Utility command for package

build rpcs3/3rdparty/curl/curl/docs/libcurl/opts/CMakeFiles/package.util: CUSTOM_COMMAND rpcs3/3rdparty/curl/curl/docs/libcurl/opts/all
  COMMAND = cd /home/user/PS3_android/build-host && /usr/bin/cpack --config ./CPackConfig.cmake
  DESC = Run CPack packaging tool...
  pool = console
  restat = 1

build rpcs3/3rdparty/curl/curl/docs/libcurl/opts/package: phony rpcs3/3rdparty/curl/curl/docs/libcurl/opts/CMakeFiles/package.util


#############################################
# Utility command for package_source

build rpcs3/3rdparty/curl/curl/docs/libcurl/opts/CMakeFiles/package_source.util: CUSTOM_COMMAND
  COMMAND = cd /home/user/PS3_android/build-host && /usr/bin/cpack --config ./CPackSourceConfig.cmake /home/user/PS3_android/build-host/CPackSourceConfig.cmake
  DESC = Run CPack packaging tool for source...
  pool = console
  restat = 1

build rpcs3/3rdparty/curl/curl/docs/libcurl/opts/package_source: phony rpcs3/3rdparty/curl/curl/docs/libcurl/opts/CMakeFiles/package_source.util


#############################################
# Utility command for edit_cache

build rpcs3/3rdparty/curl/curl/docs/libcurl/opts/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/user/PS3_android/build-host/rpcs3/3rdparty/curl/curl/docs/libcurl/opts && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
